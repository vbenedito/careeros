# Optional for development builds: defaults are built in (dashboard at http://localhost:3000).
# Copy to apps/extension/.env.development or .env.production (never commit them). Read by Vite at build time.

# Dashboard origin allowed to message the extension (AUTH-06). Required and https-only for production builds.
VITE_DASHBOARD_ORIGIN=http://localhost:3000

# Used from #12 (extension auth). Values from `pnpm db:status` locally.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
