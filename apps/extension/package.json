{
  "name": "@careeros/extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "CareerOS Chrome extension (Manifest V3).",
  "scripts": {
    "build": "NODE_ENV=development vite build --mode development && node scripts/check-worker.ts",
    "build:prod": "NODE_ENV=production vite build --mode production",
    "release": "pnpm build:prod && node scripts/zip.ts production",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.popup.json && tsc -p tsconfig.node.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@careeros/shared": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
