{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "chrome"],
    "lib": ["ES2023", "DOM"],
    // The landing responsive test imports the web app's renderer, which uses its `@/` alias.
    "paths": { "@/*": ["../web/*"] }
  },
  "include": [
    "*.test.ts",
    "manifest.config.ts",
    "scripts",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.e2e.config.ts",
    "vitest.responsive.config.ts"
  ]
}
