# Copy to apps/web/.env.local (never commit .env.local).
# Local values: run `pnpm db:start`, then `pnpm db:status` and copy the API URL and keys.

# This dashboard's own origin: OAuth redirects and Origin checks (SEC-08). Never taken from the request.
SITE_URL=http://localhost:3000

# Public — safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_ (SEC-07). Used by /api/extension/link and account deletion.
SUPABASE_SECRET_KEY=

# ID of the extension build this dashboard talks to (AUTH-06). Dev build: jfklbpedlpkginmdfckogdgaggmdmkbk; prod build: negamegjachlkaemamlfhaecippkncbl.
NEXT_PUBLIC_EXTENSION_ID=jfklbpedlpkginmdfckogdgaggmdmkbk
